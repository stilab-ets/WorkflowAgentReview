# Copy to .env and fill in before running anything under data_collection/ or
# rq3/get_yaml_diff_files.py. Nothing else in the package needs a token.
#
# A single classic or fine-grained personal access token with public-repo
# read scope is enough. No write scopes are required.
GITHUB_TOKEN=

# Optional: the human-PR fetcher (data_collection/fetch-eligible-human-prs.py)
# rotates across a pool of tokens to stay under GitHub's rate limits.
# Provide a comma-separated list instead of, or in addition to, GITHUB_TOKEN.
# GITHUB_TOKENS=token_one,token_two,token_three
